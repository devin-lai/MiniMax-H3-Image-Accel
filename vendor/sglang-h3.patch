+++ b/python/sglang/multimodal_gen/runtime/models/dits/minimax_h3_prof.py
@@ -0,0 +1,48 @@
+"""Opt-in synchronized segment timer for the H3 DiT block stack.
+
+Set H3_OPT_BLOCK_PROFILE=1 to log, per DiT forward, the CUDA-synchronized
+wall time of each block segment. Synchronization removes compute/collective
+overlap, so use it for attribution only and never for latency claims.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+import time
+from collections import defaultdict
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+ENABLED = os.environ.get("H3_OPT_BLOCK_PROFILE", "0") == "1"
+_acc: dict[str, float] = defaultdict(float)
+_last = 0.0
+
+
+def start() -> None:
+    global _last
+    if ENABLED:
+        torch.cuda.synchronize()
+        _last = time.perf_counter()
+
+
+def mark(name: str) -> None:
+    global _last
+    if ENABLED:
+        torch.cuda.synchronize()
+        now = time.perf_counter()
+        _acc[name] += now - _last
+        _last = now
+
+
+def flush(rows: int) -> None:
+    if ENABLED and _acc:
+        total = sum(_acc.values())
+        parts = " ".join(
+            f"{k}={v * 1e3:.1f}"
+            for k, v in sorted(_acc.items(), key=lambda kv: -kv[1])
+        )
+        logger.info("H3_PROF rows=%d total_ms=%.1f %s", rows, total * 1e3, parts)
+        _acc.clear()
diff --git a/python/sglang/multimodal_gen/runtime/models/dits/minimax_h3_qulysses.py b/python/sglang/multimodal_gen/runtime/models/dits/minimax_h3_qulysses.py
