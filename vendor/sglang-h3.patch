+"""Bounded native Qwen3-VL prefix KV reuse for pure-text H3 conditioning."""
+from __future__ import annotations
+
+import logging
+import torch
+from transformers.cache_utils import DynamicCache
+
+logger = logging.getLogger(__name__)
+
+
+class H3PrefixKVCache:
+    """One immutable previous prefill; every continuation gets a fresh cache.
+
+    Multimodal inputs bypass this cache: matching token IDs alone would not
+    establish matching visual embeddings or mRoPE positions.
+    """
+    def __init__(self, min_prefix_tokens: int = 128, max_bytes: int = 256 * 1024**2):
+        self.min_prefix_tokens = min_prefix_tokens
+        self.max_bytes = max_bytes
+        self.ids = ()
+        self.positions = None
+        self.hidden = self.past = None
+        self.hits = self.misses = 0
+
+    def clear(self):
+        self.ids = ()
+        self.positions = self.hidden = self.past = None
+
+    @staticmethod
+    def _layers(cache):
+        return [(layer.keys, layer.values) for layer in cache.layers]
+
+    @torch.no_grad()
+    def encode(self, model, host_ids, ids, position_ids=None):
+        count = ids.shape[1]
+        if position_ids is None:
+            host_pos = torch.arange(count).view(1, 1, -1).expand(3, 1, -1)
+        else:
+            host_pos = position_ids.detach().to("cpu", dtype=torch.long)
+        if host_pos.ndim == 2:
+            host_pos = host_pos.unsqueeze(0).expand(3, -1, -1)
+        tokens = tuple(host_ids[0].tolist())
+        common = 0
+        for old, new in zip(self.ids, tokens):
+            if old != new:
+                break
+            common += 1
+        if self.positions is not None and common:
+            equal = (self.positions[..., :common] == host_pos[..., :common]).all(dim=0).all(dim=0)
+            mismatch = (~equal).nonzero()
+            if mismatch.numel():
+                common = int(mismatch[0, 0])
+        if common < self.min_prefix_tokens or self.past is None:
+            common = 0
+        if common == count:
+            self.hits += 1
+            return self.hidden[:, :count].clone()
+        past = DynamicCache(config=model.language_model.config)
+        if common:
+            for layer_index, (key, value) in enumerate(self._layers(self.past)):
+                past.update(key[:, :, :common], value[:, :, :common], layer_index)
+        q_len = count - common
+        mask = None
+        if common:
+            q_positions = torch.arange(common, count, device=ids.device)
+            k_positions = torch.arange(count, device=ids.device)
+            mask = (k_positions[None, :] <= q_positions[:, None])[None, None]
+        result = model(
+            input_ids=ids[:, common:],
+            position_ids=host_pos[..., common:].to(ids.device),
+            attention_mask=mask,
+            past_key_values=past, use_cache=True,
+            cache_position=torch.arange(common, count, device=ids.device),
+            return_dict=True, output_attentions=False, output_hidden_states=False,
+        )
+        suffix = result.last_hidden_state
+        hidden = torch.cat((self.hidden[:, :common], suffix), dim=1) if common else suffix
+        size = hidden.numel() * hidden.element_size()
+        for key, value in self._layers(result.past_key_values):
+            size += key.numel() * key.element_size() + value.numel() * value.element_size()
+        if size <= self.max_bytes:
+            self.ids, self.positions = tokens, host_pos.clone()
+            self.hidden, self.past = hidden.detach(), result.past_key_values
+        else:
+            self.clear()
+        self.hits += bool(common)
+        self.misses += not bool(common)
+        if not torch.distributed.is_initialized() or torch.distributed.get_rank() == 0:
+            logger.info("H3_PREFIX_KV reused_tokens=%d new_tokens=%d retained_bytes=%d", common, q_len, size if size <= self.max_bytes else 0)
+        return hidden
