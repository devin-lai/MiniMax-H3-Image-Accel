diff --git a/python/sglang/multimodal_gen/runtime/distributed/h3_host_exchange.py b/python/sglang/multimodal_gen/runtime/distributed/h3_host_exchange.py
new file mode 100644
--- /dev/null
+++ b/python/sglang/multimodal_gen/runtime/distributed/h3_host_exchange.py
@@ -0,0 +1,242 @@
+"""Host-staged all-to-all for sequence-parallel groups without GPU peer access.
+
+Every rank owns one anonymous shared-memory file (memfd) with one outbound
+region per peer. The file is mapped by all ranks of the group and registered
+with CUDA as page-locked memory, so a message is one device-to-host DMA on the
+sender and one host-to-device DMA on the receiver. On PCIe 4.0 x16 L20s each
+direction moves about 24 GB/s, against roughly 6-9 GB/s for the NCCL
+host-allocation transport on the same node.
+
+Protocol. All ranks run the same ordered list of exchanges. Exchange ``n``
+splits every message into the same number of byte chunks and then:
+
+  1. drains the local stream; everything received in exchange ``n-1`` has now
+     landed, so it publishes ``ack = n-1``
+  2. waits until every peer acknowledged ``n-1`` (their previous inbound
+     copies no longer read our regions)
+  3. per chunk: queues the device-to-host copies, queues host-to-device copies
+     for whatever chunks the peers have published so far on a second stream,
+     drains the outbound copies and publishes the chunk
+  4. queues the remaining inbound chunks and makes the caller's stream wait
+     for the inbound stream
+
+A PCIe link is full duplex, so step 3 overlaps a rank's outbound chunk with
+its peers' previous chunk and an exchange costs little more than one
+direction. Counters are aligned 64-bit words in the owner's header page; x86
+stores of that size are atomic, and waiters spin.
+
+When every peer receives the same source tensor (all-gather), the sender
+stages it once and publishes a shared-region flag alongside the counters.
+Every receiver reads that one region. Explicit copy directions avoid CUDA's
+pointer-kind inference on every chunk.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import mmap
+import os
+import time
+
+import numpy as np
+import torch
+
+_HEADER = 4096
+_SYS_MEMFD_CREATE = 319  # x86_64
+_CUDA_MEMCPY_HOST_TO_DEVICE = 1
+_CUDA_MEMCPY_DEVICE_TO_HOST = 2
+_cudart = None
+
+
+def _runtime():
+    global _cudart
+    if _cudart is None:
+        last = None
+        for name in ("libcudart.so.13", "libcudart.so.12", "libcudart.so"):
+            try:
+                lib = ctypes.CDLL(name)
+                break
+            except OSError as exc:  # pragma: no cover - depends on the install
+                last = exc
+        else:
+            raise RuntimeError(f"CUDA runtime library not found: {last}")
+        lib.cudaHostRegister.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_uint]
+        lib.cudaHostRegister.restype = ctypes.c_int
+        lib.cudaMemcpyAsync.argtypes = [
+            ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int, ctypes.c_void_p,
+        ]
+        lib.cudaMemcpyAsync.restype = ctypes.c_int
+        _cudart = lib
+    return _cudart
+
+
+def _map_registered(fd: int, size: int) -> tuple[mmap.mmap, np.ndarray, int]:
+    mapping = mmap.mmap(fd, size, flags=mmap.MAP_SHARED | mmap.MAP_POPULATE)
+    array = np.frombuffer(mapping, dtype=np.uint8)
+    pointer = array.ctypes.data
+    status = _runtime().cudaHostRegister(pointer, size, 0)
+    if status != 0:
+        raise RuntimeError(f"cudaHostRegister failed with CUDA error {status}")
+    return mapping, array, pointer
+
+
+class HostExchange:
+    """One rank's endpoint. ``all_gather`` performs the one-time handshake."""
+
+    def __init__(self, world_size: int, rank: int, capacity: int, all_gather, device):
+        if os.uname().machine != "x86_64":
+            raise RuntimeError("the host exchange requires x86_64 Linux")
+        self.world_size, self.rank, self.capacity = world_size, rank, capacity
+        self.timeout = float(os.environ.get("H3_OPT_HOST_A2A_TIMEOUT", "120"))
+        self.size = _HEADER + (world_size - 1) * capacity
+        libc = ctypes.CDLL(None, use_errno=True)
+        fd = libc.syscall(_SYS_MEMFD_CREATE, b"h3-host-exchange", 0)
+        if fd < 0:
+            raise OSError(ctypes.get_errno(), "memfd_create failed")
+        os.ftruncate(fd, self.size)
+        self._keep = [_map_registered(fd, self.size)]
+        own = self._keep[0]
+        self._own_ptr = own[2]
+        self._own_words = np.frombuffer(own[0], dtype=np.uint64, count=3)
+        self._own_words[:] = 0
+        ident = torch.tensor([[os.getpid(), fd]], dtype=torch.int64, device=device)
+        idents = all_gather(ident).cpu().tolist()
+        self._peer_ptr: dict[int, int] = {}
+        self._peer_words: dict[int, np.ndarray] = {}
+        for peer, (pid, peer_fd) in enumerate(idents):
+            if peer == rank:
+                continue
+            handle = os.open(f"/proc/{pid}/fd/{peer_fd}", os.O_RDWR)
+            mapped = _map_registered(handle, self.size)
+            os.close(handle)
+            self._keep.append(mapped)
+            self._peer_ptr[peer] = mapped[2]
+            self._peer_words[peer] = np.frombuffer(mapped[0], dtype=np.uint64, count=3)
+        self.peers = sorted(self._peer_ptr)
+        self.seq = 0
+        self.chunk_bytes = int(os.environ.get("H3_OPT_HOST_A2A_CHUNK_KB", "1024")) << 10
+        self.max_chunks = int(os.environ.get("H3_OPT_HOST_A2A_MAX_CHUNKS", "8"))
+        self._inbound = None
+        self._event = torch.cuda.Event()
+
+    def _slot(self, owner: int, reader: int) -> int:
+        # the owner's region read by ``reader``
+        return _HEADER + (reader - (reader > owner)) * self.capacity
+
+    def _wait(self, word: int, value: int, peers=None) -> None:
+        pending = list(self.peers if peers is None else peers)
+        deadline = None
+        spins = 0
+        while pending:
+            pending = [p for p in pending if self._peer_words[p][word] < value]
+            spins += 1
+            if spins & 0xFFF == 0:
+                now = time.monotonic()
+                if deadline is None:
+                    deadline = now + self.timeout
+                elif now > deadline:
+                    raise RuntimeError(
+                        f"host exchange {value} timed out waiting for ranks {pending}"
+                    )
+
+    @staticmethod
+    def _segments(tensors, chunks: int):
+        """Split a message into ``chunks`` lists of (device pointer, offset, bytes)."""
+        spans, total = [], 0
+        for tensor in tensors:
+            nbytes = tensor.numel() * tensor.element_size()
+            spans.append((tensor.data_ptr(), total, nbytes))
+            total += nbytes
+        step = -(-total // chunks)
+        out = []
+        for index in range(chunks):
+            low, high = index * step, min((index + 1) * step, total)
+            pieces = []
+            for pointer, begin, nbytes in spans:
+                a, b = max(low, begin), min(high, begin + nbytes)
+                if a < b:
+                    pieces.append((pointer + a - begin, a, b - a))
+            out.append(pieces)
+        return out, total
+
+    def exchange(self, sends: dict[int, list], recvs: dict[int, list]) -> None:
+        """``sends[peer]``/``recvs[peer]``: lists of contiguous CUDA tensors.
+
+        Peers must list the same byte sizes in the same order, and every rank
+        must send every peer the same number of bytes.
+        """
+        copy = _runtime().cudaMemcpyAsync
+        stream = torch.cuda.current_stream()
+        outbound = stream.cuda_stream
+        if self._inbound is None:
+            self._inbound = torch.cuda.Stream()
+        inbound = self._inbound.cuda_stream
+        self.seq += 1
+        seq = self.seq
+        first = next(iter(sends.values()))
+        nbytes = sum(t.numel() * t.element_size() for t in first)
+        if nbytes > self.capacity:
+            raise RuntimeError("host exchange message exceeds its region")
+        chunks = max(1, min(self.max_chunks, nbytes // self.chunk_bytes))
+        out_plan = {p: self._segments(t, chunks)[0] for p, t in sends.items()}
+        in_plan = {p: self._segments(t, chunks)[0] for p, t in recvs.items()}
+        # All-gather sends the same reduced shard to every peer. Stage it once
+        # in shared host memory; all readers DMA from that same region.
+        signature = [(t.data_ptr(), t.numel() * t.element_size()) for t in first]
+        shared_send = all(
+            [(t.data_ptr(), t.numel() * t.element_size()) for t in tensors] == signature
+            for tensors in sends.values()
+        )
+        if shared_send:
+            out_plan = {next(iter(out_plan)): next(iter(out_plan.values()))}
+        received = dict.fromkeys(in_plan, 0)
+        base = seq << 10
+
+        def pull(block: bool) -> None:
+            for peer, plan in in_plan.items():
+                if block:
+                    self._wait(0, base + chunks, (peer,))
+                ready = int(self._peer_words[peer][0]) - base
+                source = self._peer_ptr[peer] + (
+                    _HEADER if self._peer_words[peer][2] else self._slot(peer, self.rank)
+                )
+                while received[peer] < min(ready, chunks):
+                    for pointer, offset, size in plan[received[peer]]:
+                        if copy(pointer, source + offset, size, _CUDA_MEMCPY_HOST_TO_DEVICE, inbound):
+                            raise RuntimeError("host-to-device copy failed")
+                    received[peer] += 1
+
+        stream.synchronize()
+        self._own_words[1] = seq - 1
+        self._wait(1, seq - 1)
+        self._own_words[2] = int(shared_send)
+        for index in range(chunks):
+            for peer, plan in out_plan.items():
+                target = self._own_ptr + (_HEADER if shared_send else self._slot(self.rank, peer))
+                for pointer, offset, size in plan[index]:
+                    if copy(target + offset, pointer, size, _CUDA_MEMCPY_DEVICE_TO_HOST, outbound):
+                        raise RuntimeError("device-to-host copy failed")
+            if index:
+                pull(False)
+            stream.synchronize()
+            self._own_words[0] = base + index + 1
+        pull(True)
+        self._event.record(self._inbound)
+        self._event.wait(stream)
+
+
+_endpoints: dict[tuple, HostExchange] = {}
+
+
+def get_host_exchange(
+    world_size: int, rank: int, all_gather, device, *, group_key="ulysses"
+) -> HostExchange:
+    # TP and Ulysses can have identical sizes/ranks on the same CUDA device.
+    # Their peers and exchange counters must never share an endpoint.
+    key = (group_key, world_size, rank, str(device))
+    endpoint = _endpoints.get(key)
+    if endpoint is None:
+        capacity = int(os.environ.get("H3_OPT_HOST_A2A_MB", "160")) << 20
+        endpoint = HostExchange(world_size, rank, capacity, all_gather, device)
+        _endpoints[key] = endpoint
+    return endpoint
diff --git a/python/sglang/multimodal_gen/runtime/distributed/h3_lossless_collectives.py b/python/sglang/multimodal_gen/runtime/distributed/h3_lossless_collectives.py
new file mode 100644
--- /dev/null
+++ b/python/sglang/multimodal_gen/runtime/distributed/h3_lossless_collectives.py
@@ -0,0 +1,82 @@
+"""Uncompressed host collectives for single-node PCIe inference.
+
+All-to-all only permutes bytes. The two-rank all-reduce performs one BF16
+addition, as NCCL does, with no quantization or change in reduction order.
+Four-rank sums calibrate and verify NCCL's reduction order before use.
+"""
+
+import os
+
+import torch
+import torch.distributed as dist
+
+from sglang.multimodal_gen.runtime.distributed.h3_host_exchange import get_host_exchange
+
+
+def _eligible(x: torch.Tensor) -> bool:
+    return (
+        x.is_cuda
+        and x.dtype == torch.bfloat16
+        and x.is_contiguous()
+        and not torch.compiler.is_compiling()
+        and not torch.cuda.is_current_stream_capturing()
+    )
+
+
+def _endpoint(x, group):
+    world, rank = dist.get_world_size(group), dist.get_rank(group)
+
+    def gather(ident):
+        out = torch.empty((world, ident.shape[-1]), dtype=ident.dtype, device=ident.device)
+        dist.all_gather_into_tensor(out, ident, group=group)
+        return out
+
+    return get_host_exchange(
+        world, rank, gather, x.device,
+        group_key=group,
+    )
+
+
+def host_all_to_all(x: torch.Tensor, out: torch.Tensor, group) -> bool:
+    """Exchange equal contiguous BF16 shards, or return False for NCCL."""
+    if os.environ.get("H3_OPT_HOST_ULYSSES", "0") != "1" or not _eligible(x):
+        return False
+    world, rank = dist.get_world_size(group), dist.get_rank(group)
+    if world < 2 or x.numel() % world:
+        return False
+    nbytes = x.numel() * x.element_size() // world
+    if nbytes > int(os.environ.get("H3_OPT_HOST_A2A_MB", "160")) << 20:
+        return False
+    endpoint = _endpoint(x, group)
+    src, dst = x.view(world, -1), out.view(world, -1)
+    dst[rank].copy_(src[rank])
+    endpoint.exchange(
+        {p: [src[p]] for p in endpoint.peers},
+        {p: [dst[p]] for p in endpoint.peers},
+    )
+    return True
+
+
+def host_bf16_all_reduce(x: torch.Tensor, group) -> torch.Tensor | None:
+    """Preserve BF16 summation; retain NCCL for small or unsupported tensors."""
+    world = dist.get_world_size(group)
+    if (
+        os.environ.get("H3_OPT_HOST_TP", "0") != "1"
+        or not _eligible(x)
+        or world not in (2, 4)
+        or x.numel() * x.element_size() < (8 << 20 if world == 4 else 256 << 10)
+        or x.numel() * x.element_size() // (world if world == 4 else 1)
+        > int(os.environ.get("H3_OPT_HOST_A2A_MB", "160")) << 20
+    ):
+        return None
+    if world == 4:
+        from sglang.multimodal_gen.runtime.distributed.h3_preserving_all_reduce import (
+            preserving_all_reduce,
+        )
+
+        return preserving_all_reduce(x, group)
+    endpoint = _endpoint(x, group)
+    peer = endpoint.peers[0]
+    received = torch.empty_like(x)
+    endpoint.exchange({peer: [x]}, {peer: [received]})
+    return x.add_(received)
diff --git a/python/sglang/multimodal_gen/runtime/distributed/h3_preserving_all_reduce.py b/python/sglang/multimodal_gen/runtime/distributed/h3_preserving_all_reduce.py
