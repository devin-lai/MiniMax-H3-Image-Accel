+from sglang.multimodal_gen.runtime.distributed.h3_lossless_collectives import _endpoint
+
+logger = logging.getLogger(__name__)
+_plans = OrderedDict()
+_MAX_PLANS = 16
+_PROBES = (
+    (0.326171875, -0.0162353515625, -7.90625, 7.71875),
+    (-23.75, 0.1982421875, 20.125, 0.1044921875),
+)
+_ORDERS = [p for p in itertools.permutations(range(4)) if p[0] < p[1]]
+_ORDERS += [(0, 1, 2, 3), (0, 2, 1, 3), (0, 3, 1, 2)]
+
+
+def _signatures():
+    probes = torch.tensor(_PROBES, dtype=torch.bfloat16)
+    signatures = []
+    for index, order in enumerate(_ORDERS):
+        a, b, c, d = (probes[:, i] for i in order)
+        value = ((a + b) + c) + d if index < 12 else (a + b) + (c + d)
+        signatures.append(tuple(value.view(torch.int16).tolist()))
+    assert len(set(signatures)) == 15
+    return signatures
+
+
+_SIGNATURES = _signatures()
+
+
+@triton.jit
+def _reduce_kernel(src, plan, dst, N: tl.constexpr, START: tl.constexpr, BLOCK: tl.constexpr):
+    i = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    p = tl.load(plan + (START + i) // 16, i < N, other=0).to(tl.int32)
+    x0 = tl.load(src + i, i < N, other=0).to(tl.float32)
+    x1 = tl.load(src + N + i, i < N, other=0).to(tl.float32)
+    x2 = tl.load(src + 2 * N + i, i < N, other=0).to(tl.float32)
+    x3 = tl.load(src + 3 * N + i, i < N, other=0).to(tl.float32)
+    ia, ib, ic, id_ = p & 3, (p >> 2) & 3, (p >> 4) & 3, (p >> 6) & 3
+    a = tl.where(ia == 0, x0, tl.where(ia == 1, x1, tl.where(ia == 2, x2, x3)))
+    b = tl.where(ib == 0, x0, tl.where(ib == 1, x1, tl.where(ib == 2, x2, x3)))
+    c = tl.where(ic == 0, x0, tl.where(ic == 1, x1, tl.where(ic == 2, x2, x3)))
+    d = tl.where(id_ == 0, x0, tl.where(id_ == 1, x1, tl.where(id_ == 2, x2, x3)))
+    ab = (a + b).to(tl.bfloat16).to(tl.float32)
+    chain = (ab + c).to(tl.bfloat16).to(tl.float32) + d
+    cd = (c + d).to(tl.bfloat16).to(tl.float32)
+    out = tl.where((p & 256) != 0, ab + cd, chain)
+    tl.store(dst + i, out, i < N)
+
+
+def _agree(ok, group, device):
+    flag = torch.tensor(int(ok), dtype=torch.int32, device=device)
+    dist.all_reduce(flag, op=dist.ReduceOp.MIN, group=group)
+    return bool(flag.item())
+
+
+def _calibrate(x, group):
+    rank = dist.get_rank(group)
+    bits = []
+    constant = True
+    for values in _PROBES:
+        probe = torch.full_like(x, values[rank])
+        dist.all_reduce(probe, group=group)
+        words = probe.view(torch.int16).view(-1, 16)
+        constant = constant and bool((words == words[:, :1]).all().item())
+        bits.append(words[:, 0].clone())
+    plan = torch.full_like(bits[0], -1, dtype=torch.int16)
+    for i, (s0, s1) in enumerate(_SIGNATURES):
+        order = _ORDERS[i]
+        code = sum(value << (2 * j) for j, value in enumerate(order))
+        code |= 256 if i >= 12 else 0
+        plan[(bits[0] == s0) & (bits[1] == s1)] = code
+    if not _agree(constant and bool((plan >= 0).all().item()), group, x.device):
+        return None
+    return plan
+
+
+def _run(x, group, plan):
+    endpoint = _endpoint(x, group)
+    rank = endpoint.rank
+    flat = x.view(4, -1)
+    count = flat.shape[1]
+    received = torch.empty_like(flat)
+    received[rank].copy_(flat[rank])
+    endpoint.exchange(
+        {p: [flat[p]] for p in endpoint.peers},
+        {p: [received[p]] for p in endpoint.peers},
+    )
+    reduced = torch.empty_like(flat[rank])
+    _reduce_kernel[(triton.cdiv(count, 1024),)](
+        received, plan, reduced, count, rank * count, 1024,
+    )
+    out = torch.empty_like(x)
+    parts = out.view(4, -1)
+    parts[rank].copy_(reduced)
+    endpoint.exchange(
+        {p: [reduced] for p in endpoint.peers},
+        {p: [parts[p]] for p in endpoint.peers},
+    )
+    return out
+
+
+def preserving_all_reduce(x: torch.Tensor, group) -> torch.Tensor | None:
+    if x.numel() % 64:
+        return None
+    # Different NCCL communicators may use different reduction trees even when
+    # their global rank lists agree (e.g. folded encoder versus DiT TP).
+    key = (group, str(x.device), x.numel())
+    if key in _plans:
+        plan = _plans[key]
+        _plans.move_to_end(key)
+        return None if plan is None else _run(x, group, plan)
+    if len(_plans) >= _MAX_PLANS:
+        _plans.popitem(last=False)
+    plan = _calibrate(x, group)
+    if plan is None:
+        _plans[key] = None
+        logger.warning("H3 BF16 host sum: unknown NCCL reduction plan; keeping NCCL")
+        return None
+    expected = x.clone()
+    dist.all_reduce(expected, group=group)
+    actual = _run(x, group, plan)
+    exact = torch.equal(actual.view(torch.int16), expected.view(torch.int16))
+    if not _agree(exact, group, x.device):
+        _plans[key] = None
+        logger.warning("H3 BF16 host sum: NCCL byte check failed; keeping NCCL")
+        return expected
+    _plans[key] = plan
+    logger.info("H3 BF16 host sum: verified NCCL reduction order for %d elements", x.numel())
+    return actual
