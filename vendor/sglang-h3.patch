+# SPDX-License-Identifier: Apache-2.0
+"""CPU dispatch checks for both H3 Sage FP16-PV experiment interfaces."""
+
+import sys
+from types import ModuleType
+from unittest.mock import Mock
+
+import pytest
+import torch
+
+from sglang.multimodal_gen.runtime.layers.attention.backends.sage_attn import (
+    SageAttentionImpl,
+)
+
+
+@pytest.mark.parametrize(
+    "pv,legacy,granularity",
+    [("auto", "0", None), ("fp16", "0", "per_thread"),
+     ("auto", "1", "per_warp"), ("fp16", "1", "per_thread")],
+)
+def test_h3_sage_flags_preserve_each_experiments_quantization(
+    monkeypatch, pv, legacy, granularity
+):
+    monkeypatch.setenv("H3_OPT_SAGE2_PV", pv)
+    monkeypatch.setenv("H3_OPT_SAGE_FP16_PV", legacy)
+    monkeypatch.setenv("SGLANG_USE_SAGE_ATTENTION_IMPL", "auto")
+    query = torch.randn(1, 8, 1, 64)
+    sage = ModuleType("sageattention")
+    sage.sageattn = Mock(return_value=query)
+    sage.sageattn_qk_int8_pv_fp16_cuda = Mock(return_value=query)
+    monkeypatch.setitem(sys.modules, "sageattention", sage)
+    implementation = SageAttentionImpl(1, 64, False, 0.125)
+    assert implementation.forward(query, query, query, None) is query
+    if granularity is None:
+        sage.sageattn.assert_called_once()
+        sage.sageattn_qk_int8_pv_fp16_cuda.assert_not_called()
+    else:
+        sage.sageattn.assert_not_called()
+        kwargs = sage.sageattn_qk_int8_pv_fp16_cuda.call_args.kwargs
+        assert kwargs["qk_quant_gran"] == granularity
+        assert kwargs["pv_accum_dtype"] == "fp32"
+        assert kwargs["tensor_layout"] == "NHD"
+
+
+@pytest.mark.parametrize("flag", ["H3_OPT_SAGE2_PV", "H3_OPT_SAGE_FP16_PV"])
+@pytest.mark.parametrize("implementation", ["trtllm_gen", "trtllm-gen"])
+def test_both_fp16_pv_flags_reject_trtllm(monkeypatch, flag, implementation):
+    monkeypatch.setenv("H3_OPT_SAGE2_PV", "auto")
+    monkeypatch.setenv("H3_OPT_SAGE_FP16_PV", "0")
+    monkeypatch.setenv(flag, "fp16" if flag == "H3_OPT_SAGE2_PV" else "1")
+    monkeypatch.setenv("SGLANG_USE_SAGE_ATTENTION_IMPL", implementation)
+    with pytest.raises(ValueError, match="CUDA SageAttention implementation"):
+        SageAttentionImpl(1, 64, False, 0.125)
+
+
+def test_invalid_sage_pv_setting_is_rejected(monkeypatch):
+    monkeypatch.setenv("H3_OPT_SAGE2_PV", "invalid")
+    with pytest.raises(ValueError, match="H3_OPT_SAGE2_PV"):
+        SageAttentionImpl(1, 64, False, 0.125)
