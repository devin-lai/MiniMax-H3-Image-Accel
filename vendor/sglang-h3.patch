new file mode 100644
--- /dev/null
+++ b/python/sglang/multimodal_gen/runtime/models/vaes/h3_exact_graph.py
@@ -0,0 +1,152 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Verified CUDA replay of the unchanged, resident H3 image VAE block stack.
+
+Only the sequential exact-quality decoder uses this path. Tile geometry,
+batch size, operations, precision and reduction order stay unchanged. Two
+different inputs must match eager bit for bit before a graph is retained.
+"""
+
+import logging
+import weakref
+from collections import OrderedDict
+
+import torch
+from torch.utils._pytree import tree_flatten
+
+logger = logging.getLogger(__name__)
+
+
+def _version(tensor):
+    try:
+        return tensor._version
+    except RuntimeError:  # inference tensors do not carry a version counter
+        return None
+
+
+def _same_bits(a, b):
+    return (
+        a.dtype == b.dtype
+        and a.shape == b.shape
+        and torch.equal(
+            a.contiguous().view(torch.uint8), b.contiguous().view(torch.uint8)
+        )
+    )
+
+
+class H3ExactDecoderGraph:
+    def __init__(self, owner, max_entries=2):
+        self.owner = weakref.ref(owner)
+        self.max_entries = max_entries
+        self.entries = OrderedDict()
+        self.weight_signature = None
+        self.disabled = False
+        self.captures = 0
+        self.replays = 0
+
+    @staticmethod
+    def eager(blocks, hidden, rope):
+        for block in blocks:
+            hidden = block(hidden, rope)
+        return hidden
+
+    def maybe_run(self, blocks, hidden, rope):
+        owner = self.owner()
+        if (
+            self.disabled
+            or owner is None
+            or owner.training
+            or owner.decode_fast_path_gate.enabled
+            or any(m.enabled for m in getattr(owner, "layerwise_offload_managers", ()))
+            or not hidden.is_cuda
+            or torch.version.hip is not None
+            or hidden.ndim != 3
+            or hidden.shape[0] != 1
+            or hidden.shape[1] > 4096
+            or torch.is_grad_enabled()
+            or torch.compiler.is_compiling()
+            or torch.cuda.is_current_stream_capturing()
+            or torch.cuda.get_device_capability(hidden.device) != (8, 9)
+        ):
+            return None
+        params = tuple(blocks.parameters())
+        if any(p.device != hidden.device for p in params):
+            return None
+        signature = tuple(
+            (p.data_ptr(), p.shape, p.stride(), p.dtype, _version(p)) for p in params
+        )
+        if signature != self.weight_signature:
+            self.entries.clear()
+            self.weight_signature = signature
+        leaves, _ = tree_flatten(rope)
+        if not leaves or any(
+            not torch.is_tensor(t) or t.device != hidden.device for t in leaves
+        ):
+            return None
+        # The decoder owns immutable RoPE tables. Keep their actual tensors
+        # alive with each graph; a different table requires another capture.
+        rope_key = tuple(
+            (id(t), t.data_ptr(), t.shape, t.stride(), t.dtype, _version(t))
+            for t in leaves
+        )
+        key = (
+            hidden.shape,
+            hidden.stride(),
+            hidden.dtype,
+            hidden.device,
+            rope_key,
+            torch.is_autocast_enabled("cuda"),
+            torch.get_autocast_dtype("cuda"),
+            torch.backends.cuda.matmul.allow_tf32,
+            torch.backends.cuda.matmul.allow_bf16_reduced_precision_reduction,
+        )
+        if key in self.entries:
+            entry = self.entries.pop(key)
+            self.entries[key] = entry
+            graph, inputs, output, _ = entry
+            inputs.copy_(hidden)
+            graph.replay()
+            self.replays += 1
+            # Callers retain multiple tile outputs until overlap assembly.
+            return output.clone()
+        if len(self.entries) >= self.max_entries:
+            self.entries.popitem(last=False)
+        reference = self.eager(blocks, hidden, rope)
+        try:
+            inputs = torch.empty_strided(
+                hidden.shape, hidden.stride(), dtype=hidden.dtype, device=hidden.device
+            )
+            inputs.copy_(hidden)
+            current = torch.cuda.current_stream(hidden.device)
+            stream = torch.cuda.Stream(device=hidden.device)
+            stream.wait_stream(current)
+            with torch.cuda.stream(stream):
+                for _ in range(2):
+                    self.eager(blocks, inputs, rope)
+            current.wait_stream(stream)
+            graph = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(graph, stream=stream):
+                output = self.eager(blocks, inputs, rope)
+            current.wait_stream(stream)
+            graph.replay()
+            if not _same_bits(reference, output):
+                raise RuntimeError("first eager/replay byte check failed")
+            probe = -hidden
+            probe_reference = self.eager(blocks, probe, rope)
+            inputs.copy_(probe)
+            graph.replay()
+            if not _same_bits(probe_reference, output):
+                raise RuntimeError("second eager/replay byte check failed")
+            self.entries[key] = (graph, inputs, output, rope)
+            self.captures += 1
+            logger.info(
+                "H3_VAE_EXACT_GRAPH verified shape=%s entries=%d",
+                tuple(hidden.shape),
+                len(self.entries),
+            )
+        except (RuntimeError, torch.OutOfMemoryError) as exc:
+            self.entries.clear()
+            self.disabled = True
+            logger.warning(
+                "H3_VAE_EXACT_GRAPH disabled; retaining eager decoder: %s", exc
+            )
+        return reference
