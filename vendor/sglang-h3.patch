--- /dev/null
+++ b/python/sglang/multimodal_gen/runtime/distributed/h3_preserving_all_reduce.py
@@ -0,0 +1,145 @@
+"""Host reduce-scatter/all-gather preserving a four-rank NCCL BF16 sum.
+
+BF16 reduction is order-sensitive. NCCL's ring can use a different order for
+different buffer chunks. Two distinguishing scalar probes identify which of
+the 15 binary reduction trees each 16-element block uses. The first real sum
+is also checked against NCCL, on every rank. Unrecognized plans retain NCCL.
+No weights, activations, or communication payloads are quantized.
+"""
+
+import itertools
+import logging
+from collections import OrderedDict
+
+import torch
+import torch.distributed as dist
+import triton
+import triton.language as tl
