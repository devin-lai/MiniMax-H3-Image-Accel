+++ b/python/sglang/multimodal_gen/runtime/models/vaes/h3_image_output.py
@@ -0,0 +1,48 @@
+"""Fuse image quantization/layout before copying final pixels to the host."""
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _quantize_hwc(X, Y, count: tl.constexpr, channels: tl.constexpr,
+                  height: tl.constexpr, width: tl.constexpr,
+                  s0: tl.constexpr, s1: tl.constexpr, s2: tl.constexpr,
+                  s3: tl.constexpr, BLOCK: tl.constexpr):
+    offset = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    channel = offset % channels
+    pixel = offset // channels
+    x = pixel % width
+    y = (pixel // width) % height
+    batch = pixel // (height * width)
+    value = tl.load(X + batch*s0 + channel*s1 + y*s2 + x*s3,
+                    mask=offset < count, other=0).to(tl.float32)
+    value = tl.minimum(tl.maximum(value * 255.0, 0.0), 255.0)
+    tl.store(Y + offset, value.to(tl.uint8), mask=offset < count)
+
+
+def h3_image_uint8_host(pixels: torch.Tensor):
+    """Return BCHW uint8 tensors in HWC storage; match native truncation.
+
+    The original saver copies FP32 BCHW, then multiplies/clamps/truncates and
+    transposes on the CPU. This copies only the final uint8 HWC buffer (4x less).
+    Lanczos resizing retains its original CPU path at the call site.
+    """
+    if pixels.ndim != 4 or not pixels.is_cuda:
+        raise ValueError("GPU image output requires CUDA BCHW pixels")
+    batch, channels, height, width = pixels.shape
+    output = torch.empty((batch, 1, height, width, channels),
+                         device=pixels.device, dtype=torch.uint8)
+    count = output.numel()
+    _quantize_hwc[(triton.cdiv(count, 1024),)](
+        pixels, output, count, channels, height, width, *pixels.stride(),
+        BLOCK=1024, enable_fp_fusion=False,
+    )
+    try:
+        host = torch.empty(output.shape, dtype=torch.uint8, pin_memory=True)
+    except RuntimeError:
+        host = output.cpu()
+    else:
+        host.copy_(output, non_blocking=True)
+        torch.cuda.current_stream(pixels.device).synchronize()
+    return host[:, 0].permute(0, 3, 1, 2)
