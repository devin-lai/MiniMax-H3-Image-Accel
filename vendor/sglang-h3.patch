--- /dev/null
+++ b/python/sglang/multimodal_gen/runtime/models/dits/minimax_h3_opt.py
@@ -0,0 +1,141 @@
+"""Explicit, request-scoped H3 image approximations.
+
+Default requests retain the original six-step path. Sparse schedules keep the
+original PDD head indices and advance by the corresponding sigma distance;
+they are approximations, not replacement distilled weights.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+import logging
+import math
+from typing import Any
+
+import torch
+import torch.distributed as dist
+
+logger = logging.getLogger(__name__)
+
+
+def validate_h3_opt(value: dict[str, Any] | None, total_steps: int = 6) -> dict[str, Any]:
+    if value is None:
+        return {}
+    if not isinstance(value, dict):
+        raise ValueError("h3_opt must be a JSON object")
+    allowed = {"steps", "merge_heads", "prefix_kv", "tea_threshold", "tea_max_skip", "tea_warmup", "reuse_steps"}
+    unknown = set(value) - allowed
+    if unknown:
+        raise ValueError(f"Unknown h3_opt options: {sorted(unknown)}")
+    cfg = dict(value)
+    if "prefix_kv" in cfg and type(cfg["prefix_kv"]) is not bool:
+        raise ValueError("prefix_kv must be boolean")
+    if "merge_heads" in cfg and type(cfg["merge_heads"]) is not bool:
+        raise ValueError("merge_heads must be boolean")
+    if cfg.get("merge_heads") and "steps" not in cfg:
+        raise ValueError("merge_heads requires an explicit sparse steps schedule")
+    if "steps" in cfg:
+        steps = cfg["steps"]
+        if (
+            not isinstance(steps, list)
+            or any(type(i) is not int for i in steps)
+            or len(steps) < 2
+            or steps != sorted(set(steps))
+            or steps[0] != 0
+            or steps[-1] != total_steps - 1
+        ):
+            raise ValueError(f"h3_opt.steps must increase from 0 to {total_steps - 1}")
+    threshold = cfg.get("tea_threshold", 0.0)
+    if isinstance(threshold, bool) or not isinstance(threshold, (int, float)) or not math.isfinite(threshold) or threshold < 0:
+        raise ValueError("tea_threshold must be a finite non-negative number")
+    for name, default in (("tea_max_skip", 1), ("tea_warmup", 2)):
+        n = cfg.get(name, default)
+        if type(n) is not int or not 1 <= n <= total_steps:
+            raise ValueError(f"{name} must be an integer in [1, {total_steps}]")
+    reuse = cfg.get("reuse_steps", [])
+    if not isinstance(reuse, list) or any(type(i) is not int or not 1 <= i < total_steps - 1 for i in reuse):
+        raise ValueError("reuse_steps may contain only interior original step indices")
+    if len(reuse) != len(set(reuse)):
+        raise ValueError("reuse_steps must be unique")
+    return cfg
+
+
+def fuse_velocity_heads(weight: torch.Tensor, bias: torch.Tensor, deltas: tuple[float, ...]):
+    """Fuse linear Euler heads under a shared-hidden-state approximation."""
+    scale = torch.tensor(deltas, device=weight.device, dtype=torch.float32)
+    scale = scale / scale.sum()
+    w = (weight.float() * scale[:, None, None]).sum(dim=0).to(weight.dtype)
+    b = (bias.float() * scale[:, None]).sum(dim=0).to(bias.dtype)
+    return w, b
+
+
+@dataclass
+class H3ImageOptState:
+    cfg: dict[str, Any]
+    selected_steps: list[int]
+    target_start: int
+    target_stop: int
+    residual: torch.Tensor | None = None
+    previous_sample: torch.Tensor | None = None
+    full_input: torch.Tensor | None = None
+    accumulated_change: float = 0.0
+    skipped: int = 0
+    full_passes: int = 0
+    reused_passes: int = 0
+    relative_changes: list[float] = field(default_factory=list)
+
+    def begin(self, hidden: torch.Tensor, step: int) -> tuple[bool, torch.Tensor]:
+        """TeaCache-style cumulative relative-L1 gating over target input rows.
+
+        This image-specific gate is intentionally uncalibrated by a video-model
+        polynomial. Thresholds are measured on matched image outputs.
+        """
+        threshold = float(self.cfg.get("tea_threshold", 0.0))
+        forced = step in self.cfg.get("reuse_steps", ())
+        warmup = int(self.cfg.get("tea_warmup", 2))
+        last = step == self.selected_steps[-1]
+        can_reuse = self.residual is not None and self.full_passes >= warmup and not last
+        reuse = False
+        relative_change = None
+        if threshold > 0:
+            # Sample deterministic channels/rows, excluding text, references,
+            # and alignment padding. The scalar gate is synchronized globally.
+            sample = hidden[self.target_start:self.target_stop:4, ::16].float()
+            if self.previous_sample is not None:
+                change = (sample - self.previous_sample).abs().sum()
+                magnitude = self.previous_sample.abs().sum()
+                stats = torch.stack((change, magnitude))
+                if dist.is_initialized() and dist.get_world_size() > 1:
+                    dist.all_reduce(stats)
+                relative_change = float((stats[0] / stats[1].clamp_min(1e-8)).item())
+                self.accumulated_change += relative_change
+                self.relative_changes.append(round(relative_change, 6))
+            self.previous_sample = sample.detach()
+            reuse = can_reuse and self.accumulated_change < threshold
+        reuse = can_reuse and (
+            forced or (reuse and self.skipped < int(self.cfg.get("tea_max_skip", 1)))
+        )
+        if reuse:
+            self.skipped += 1
+            self.reused_passes += 1
+            return False, (hidden.float() + self.residual).to(hidden.dtype)
+        self.accumulated_change = 0.0
+        self.skipped = 0
+        # H3's fused residual writes its input in place, so retain a distinct
+        # copy before the first block, not a detached view of the same storage.
+        self.full_input = hidden.clone()
+        self.full_passes += 1
+        return True, hidden
+
+    def finish(self, hidden: torch.Tensor) -> None:
+        if self.full_input is None:
+            raise RuntimeError("H3 residual cache did not capture an independent input")
+        self.residual = hidden.float() - self.full_input.float()
+        self.full_input = None
+
+    def release(self) -> None:
+        self.residual = self.previous_sample = self.full_input = None
+        if not dist.is_initialized() or dist.get_rank() == 0:
+            logger.info(
+                "H3_OPT steps=%s full_DiT_passes=%d residual_reuses=%d relative_changes=%s config=%s",
+                self.selected_steps, self.full_passes, self.reused_passes, self.relative_changes, self.cfg,
+            )
diff --git a/python/sglang/multimodal_gen/runtime/models/dits/minimax_h3_prof.py b/python/sglang/multimodal_gen/runtime/models/dits/minimax_h3_prof.py
