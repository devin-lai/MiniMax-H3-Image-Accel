@@ -0,0 +1,403 @@
+"""Quantize-before-exchange Ulysses attention for H3 on SM89 (L20/L40/RTX 40).
+
+SageAttention2 turns Q/K into INT8 and V into FP8 on the rank that attends,
+and the FP8 output projection turns the attention output into per-row FP8 on
+the rank that owns the rows. The stock Ulysses path therefore ships BF16
+tensors across the group only to quantize them on arrival. Here each rank
+quantizes its own row shard first, so both exchanges carry one byte per
+element, and the bytes travel over the page-locked host exchange.
+
+Arithmetic contract (all ranks see the same statistics, so the result does
+not depend on how rows are sharded):
+
+* K smoothing mean and the per-channel V range come from one small exchange
+  of per-rank sums/extrema. The mean is kept in FP32 (Sage rounds it to BF16).
+* Q/K use Sage's per-thread INT8 groups. A shard is a multiple of 64 rows, so
+  every group lives on one rank and its scale equals the full-sequence scale.
+* V uses Sage's per-channel FP8 scale (range / 2.25 for the FP16 accumulator).
+* The output is per-row FP8 for the FP8 output projection. Each rank scales
+  its heads of a row by a power of two; the owner of the row moves the four
+  parts to the largest of those scales, which only shifts E4M3 exponents, so
+  no statistics exchange is needed and every part keeps its 3-bit mantissa.
+
+The attention itself is Sage's unmodified SM89 kernel.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+from sglang.multimodal_gen.runtime.distributed.h3_host_exchange import (
+    get_host_exchange,
+)
+from sglang.multimodal_gen.runtime.distributed.parallel_state import (
+    get_sp_group,
+    get_ulysses_ctx,
+)
+from sglang.multimodal_gen.runtime.models.dits import minimax_h3_prof as _prof
+
+ENABLED = os.environ.get("H3_OPT_QUANT_ULYSSES", "0") == "1"
+ROW_ALIGNMENT = 64
+_V_SCALE_MAX = 2.25
+_STATS_SPAN = 256
+_PERMUTE = (0, 1, 8, 9, 2, 3, 10, 11, 4, 5, 12, 13, 6, 7, 14, 15)
+
+
+@triton.jit
+def _quant_q_kernel(
+    x_ptr, out_ptr, scale_ptr, live_rows,
+    stride_xr, stride_xh, stride_od, stride_or, stride_oh, stride_sd,
+    HD: tl.constexpr, C: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    head = tl.program_id(1)
+    rows = (pid // 8) * 32 + tl.arange(0, 4) * 8 + pid % 8
+    cols = tl.arange(0, C)
+    live = rows[:, None] < live_rows
+    x = tl.load(
+        x_ptr + rows[:, None] * stride_xr + head * stride_xh + cols[None, :],
+        mask=live, other=0.0,
+    ).to(tl.float32)
+    scale = tl.max(tl.abs(x)) / 127.0 + 0.0000001
+    y = x / scale
+    y += 0.5 * tl.where(y >= 0, 1, -1)
+    dest = head // HD
+    local = head % HD
+    tl.store(
+        out_ptr + dest * stride_od + rows[:, None] * stride_or + local * stride_oh + cols[None, :],
+        y.to(tl.int8),
+    )
+    tl.store(scale_ptr + dest * stride_sd + pid * HD + local, scale)
+
+
+@triton.jit
+def _quant_k_kernel(
+    x_ptr, stats_ptr, out_ptr, scale_ptr, live_rows, used_rows,
+    stride_xr, stride_xh, stride_od, stride_or, stride_oh, stride_sd,
+    HD: tl.constexpr, C: tl.constexpr, H: tl.constexpr, W: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    head = tl.program_id(1)
+    index = tl.arange(0, 16)
+    rows = (pid // 4) * 64 + (index // 2) * 8 + (pid % 4) * 2 + index % 2
+    cols = tl.arange(0, C)
+    live = rows[:, None] < live_rows
+    x = tl.load(
+        x_ptr + rows[:, None] * stride_xr + head * stride_xh + cols[None, :],
+        mask=live, other=0.0,
+    ).to(tl.float32)
+    mean = tl.zeros([C], dtype=tl.float32)
+    for rank in tl.static_range(W):
+        mean += tl.load(stats_ptr + rank * 2 * H * C + head * C + cols)
+    mean = mean / used_rows
+    x = tl.where(live, x - mean[None, :], 0.0)
+    scale = tl.max(tl.abs(x)) / 127.0 + 0.0000001
+    y = x / scale
+    y += 0.5 * tl.where(y >= 0, 1, -1)
+    dest = head // HD
+    local = head % HD
+    tl.store(
+        out_ptr + dest * stride_od + rows[:, None] * stride_or + local * stride_oh + cols[None, :],
+        y.to(tl.int8),
+    )
+    tl.store(scale_ptr + dest * stride_sd + pid * HD + local, scale)
+
+
+@triton.jit
+def _quant_v_kernel(
+    x_ptr, stats_ptr, out_ptr, live_rows,
+    stride_xr, stride_xh, stride_od, stride_or, stride_oh,
+    HD: tl.constexpr, C: tl.constexpr, ROWS: tl.constexpr,
+    H: tl.constexpr, W: tl.constexpr,
+):
+    rows = tl.program_id(0) * ROWS + tl.arange(0, ROWS)
+    head = tl.program_id(1)
+    cols = tl.arange(0, C)
+    live = rows[:, None] < live_rows
+    x = tl.load(
+        x_ptr + rows[:, None] * stride_xr + head * stride_xh + cols[None, :],
+        mask=live, other=0.0,
+    ).to(tl.float32)
+    extent = tl.zeros([C], dtype=tl.float32)
+    for rank in tl.static_range(W):
+        extent = tl.maximum(
+            extent, tl.load(stats_ptr + (rank * 2 + 1) * H * C + head * C + cols)
+        )
+    y = x * (2.25 / tl.maximum(extent, 1e-10))[None, :]
+    tl.store(
+        out_ptr + (head // HD) * stride_od + rows[:, None] * stride_or
+        + (head % HD) * stride_oh + cols[None, :],
+        y.to(out_ptr.dtype.element_ty),
+    )
+
+
+@triton.jit
+def _stats_kernel(
+    k_ptr, v_ptr, out_ptr, live_rows, stride_r, stride_h,
+    H: tl.constexpr, C: tl.constexpr, ROWS: tl.constexpr, SPAN: tl.constexpr,
+):
+    head = tl.program_id(0)
+    span = tl.program_id(1)
+    out_ptr += span * 2 * H * C
+    cols = tl.arange(0, C)
+    total = tl.zeros([C], dtype=tl.float32)
+    extent = tl.zeros([C], dtype=tl.float32)
+    for first in range(span * SPAN, min((span + 1) * SPAN, live_rows), ROWS):
+        rows = first + tl.arange(0, ROWS)
+        live = rows[:, None] < live_rows
+        offset = rows[:, None] * stride_r + head * stride_h + cols[None, :]
+        total += tl.sum(tl.load(k_ptr + offset, mask=live, other=0.0).to(tl.float32), axis=0)
+        value = tl.load(v_ptr + offset, mask=live, other=0.0).to(tl.float32)
+        extent = tl.maximum(extent, tl.max(tl.abs(value), axis=0))
+    tl.store(out_ptr + head * C + cols, total)
+    tl.store(out_ptr + (H + head) * C + cols, extent)
+
+
+@triton.jit
+def _row_quant_kernel(x_ptr, out_ptr, scale_ptr, N: tl.constexpr, BLOCK: tl.constexpr):
+    row = tl.program_id(0).to(tl.int64)
+    cols = tl.arange(0, BLOCK)
+    mask = cols < N
+    x = tl.load(x_ptr + row * N + cols, mask=mask, other=0.0).to(tl.float32)
+    extent = tl.maximum(tl.max(tl.abs(x)), 1e-30)
+    scale = tl.exp2(tl.ceil(tl.log2(extent / 448.0)))
+    y = tl.clamp(x / scale, -448.0, 448.0)
+    tl.store(out_ptr + row * N + cols, y.to(out_ptr.dtype.element_ty), mask=mask)
+    tl.store(scale_ptr + row, scale)
+
+
+@triton.jit
+def _row_merge_kernel(
+    x_ptr, scale_ptr, out_ptr, common_ptr, rows,
+    N: tl.constexpr, BLOCK: tl.constexpr, W: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    part = tl.program_id(1)
+    cols = tl.arange(0, BLOCK)
+    mask = cols < N
+    common = tl.max(tl.load(scale_ptr + tl.arange(0, W) * rows + row))
+    ratio = tl.load(scale_ptr + part * rows + row) / common
+    x = tl.load(x_ptr + (part * rows + row) * N + cols, mask=mask, other=0.0).to(tl.float32)
+    tl.store(
+        out_ptr + (row * W + part) * N + cols,
+        (x * ratio).to(out_ptr.dtype.element_ty),
+        mask=mask,
+    )
+    if part == 0:
+        tl.store(common_ptr + row, common)
+
+
+def _fp8(*shape, device, zero: bool = False) -> torch.Tensor:
+    make = torch.zeros if zero else torch.empty
+    return make(*shape, dtype=torch.uint8, device=device).view(torch.float8_e4m3fn)
+
+
+def local_stats(k: torch.Tensor, v: torch.Tensor, live: int, out=None) -> torch.Tensor:
+    """[2, H, C] FP32: K column sums and V column extrema over this shard's live rows."""
+    heads, dim = k.shape[1], k.shape[2]
+    if out is None:
+        out = torch.empty(2, heads, dim, dtype=torch.float32, device=k.device)
+    spans = max(1, -(-live // _STATS_SPAN))
+    partial = torch.empty(spans, 2, heads, dim, dtype=torch.float32, device=k.device)
+    _stats_kernel[(heads, spans)](
+        k, v, partial, live, k.stride(0), k.stride(1),
+        H=heads, C=dim, ROWS=32, SPAN=_STATS_SPAN,
+    )
+    torch.sum(partial[:, 0], dim=0, out=out[0])
+    torch.amax(partial[:, 1], dim=0, out=out[1])
+    return out
+
+
+def quantize_shard(q, k, v, stats, live: int, used: int):
+    """Quantize a row shard ``[R, H, C]`` into destination-major blocks.
+
+    ``stats`` is every rank's :func:`local_stats`, ``[world, 2, H, C]``.
+    Returns q8/k8 INT8 and v8 FP8 ``[world, R, H/world, C]`` plus group-major
+    scales ``[world, groups, H/world]``.
+    """
+    rows, heads, dim = q.shape
+    world = stats.shape[0]
+    local = heads // world
+    device = q.device
+    q8 = torch.empty(world, rows, local, dim, dtype=torch.int8, device=device)
+    k8 = torch.empty_like(q8)
+    v8 = _fp8(world, rows, local, dim, device=device)
+    q_groups, k_groups = rows // 32 * 8, rows // 64 * 4
+    q_scale = torch.empty(world, q_groups, local, dtype=torch.float32, device=device)
+    k_scale = torch.empty(world, k_groups, local, dtype=torch.float32, device=device)
+    _quant_q_kernel[(q_groups, heads)](
+        q, q8, q_scale, live,
+        q.stride(0), q.stride(1), q8.stride(0), q8.stride(1), q8.stride(2), q_scale.stride(0),
+        HD=local, C=dim,
+    )
+    _quant_k_kernel[(k_groups, heads)](
+        k, stats, k8, k_scale, live, used,
+        k.stride(0), k.stride(1), k8.stride(0), k8.stride(1), k8.stride(2), k_scale.stride(0),
+        HD=local, C=dim, H=heads, W=world,
+    )
+    _quant_v_kernel[(rows // 16, heads)](
+        v, stats, v8, live,
+        v.stride(0), v.stride(1), v8.stride(0), v8.stride(1), v8.stride(2),
+        HD=local, C=dim, ROWS=16, H=heads, W=world,
+    )
+    return q8, k8, v8, q_scale, k_scale
+
+
+_permute_index: dict[torch.device, torch.Tensor] = {}
+
+
+def sage_value_layout(v8: torch.Tensor, padded: int) -> torch.Tensor:
+    """``[T, H, C]`` FP8 -> Sage's ``[1, C, H, padded]`` with its 16-token permutation."""
+    index = _permute_index.get(v8.device)
+    if index is None:
+        index = torch.tensor(_PERMUTE, device=v8.device)
+        _permute_index[v8.device] = index
+    _, heads, dim = v8.shape
+    blocks = v8[:padded].view(torch.uint8).view(padded // 16, 16, heads, dim)
+    out = blocks.permute(3, 2, 0, 1)[..., index]
+    return out.reshape(1, dim, heads, padded).view(torch.float8_e4m3fn)
+
+
+def sage_attend(q8, k8, v8, q_scale, k_scale, v_range, used: int, sm_scale: float):
+    """Run Sage's SM89 kernel on assembled ``[T, H, C]`` operands -> BF16 ``[used, H*C]``."""
+    from sageattention import sm89_compile
+
+    _, heads, dim = q8.shape
+    padded = (used + 63) // 64 * 64
+    q_groups = (used + 127) // 128 * 32
+    k_groups = padded // 64 * 4
+    out = torch.empty(1, used, heads, dim, dtype=torch.bfloat16, device=q8.device)
+    sm89_compile.qk_int8_sv_f8_accum_f16_fuse_v_scale_attn_inst_buf(
+        q8[:used].unsqueeze(0),
+        k8[:used].unsqueeze(0),
+        sage_value_layout(v8, padded),
+        out,
+        q_scale[:q_groups].t().contiguous().unsqueeze(0),
+        k_scale[:k_groups].t().contiguous().unsqueeze(0),
+        (v_range.clamp_min(1e-10) / _V_SCALE_MAX).unsqueeze(0).contiguous(),
+        0, 0, 3, sm_scale, 0,
+    )
+    return out.view(used, heads * dim)
+
+
+def row_quantize(x: torch.Tensor, total: int):
+    """BF16 ``[used, N]`` -> FP8 ``[total, N]`` and power-of-two row scales ``[total]``."""
+    rows, width = x.shape
+    out = _fp8(total, width, device=x.device, zero=True)
+    scale = torch.full((total,), 2.0**-100, dtype=torch.float32, device=x.device)
+    _row_quant_kernel[(rows,)](x, out, scale, N=width, BLOCK=triton.next_power_of_2(width))
+    return out, scale
+
+
+def row_merge(parts: torch.Tensor, scales: torch.Tensor):
+    """FP8 ``[world, R, N]`` with scales ``[world, R]`` -> FP8 ``[R, world*N]``, ``[R, 1]``."""
+    world, rows, width = parts.shape
+    out = _fp8(rows, world * width, device=parts.device)
+    common = torch.empty(rows, 1, dtype=torch.float32, device=parts.device)
+    _row_merge_kernel[(rows, world)](
+        parts, scales, out, common, rows,
+        N=width, BLOCK=triton.next_power_of_2(width), W=world,
+    )
+    return out, common
+
+
+def eligible(attention, q: torch.Tensor, bounds, max_seqlen: int) -> int | None:
+    """The live row count when this call can take the quantized exchange."""
+    if not ENABLED or bounds is None or len(bounds) != 3:
+        return None
+    world, _ = get_ulysses_ctx()
+    start, used, total = bounds
+    rows, heads, dim = q.shape
+    method = attention.out_proj.quant_method
+    if (
+        world < 2
+        or start != 0
+        or used != max_seqlen
+        or used >= total
+        or total != rows * world
+        or rows % ROW_ALIGNMENT
+        or heads % world
+        or dim != 128
+        or q.dtype != torch.bfloat16
+        or type(method).__name__ != "Fp8LinearMethod"
+        or method.block_quant
+        or method.use_marlin
+        or torch.cuda.get_device_capability(q.device) != (8, 9)
+    ):
+        return None
+    return used
+
+
+def quantized_ulysses_attention(q, k, v, *, used: int, sm_scale: float):
+    """Normalized ``[R, H, C]`` Q/K/V -> (FP8 ``[R, H*C]``, per-row scale ``[R, 1]``)."""
+    world, rank = get_ulysses_ctx()
+    rows, heads, dim = q.shape
+    local = heads // world
+    total = rows * world
+    start = rank * rows
+    live = min(max(used - start, 0), rows)
+    device = q.device
+    exchange = get_host_exchange(world, rank, get_sp_group().all_gather, device)
+    peers = exchange.peers
+
+    stats = torch.empty(world, 2, heads, dim, dtype=torch.float32, device=device)
+    local_stats(k, v, live, stats[rank])
+    exchange.exchange(
+        {p: [stats[rank]] for p in peers}, {p: [stats[p]] for p in peers}
+    )
+    _prof.mark("qu_stats")
+
+    q8, k8, v8, q_scale, k_scale = quantize_shard(q, k, v, stats, live, used)
+    q_groups, k_groups = q_scale.shape[1], k_scale.shape[1]
+    q_all = torch.empty(total, local, dim, dtype=torch.int8, device=device)
+    k_all = torch.empty_like(q_all)
+    v_all = _fp8(total, local, dim, device=device)
+    qs_all = torch.empty(world * q_groups, local, dtype=torch.float32, device=device)
+    ks_all = torch.empty(world * k_groups, local, dtype=torch.float32, device=device)
+
+    def slots(p):
+        return [
+            q_all[p * rows : (p + 1) * rows],
+            k_all[p * rows : (p + 1) * rows],
+            v_all[p * rows : (p + 1) * rows],
+            qs_all[p * q_groups : (p + 1) * q_groups],
+            ks_all[p * k_groups : (p + 1) * k_groups],
+        ]
+
+    for dst, src in zip(slots(rank), (q8, k8, v8, q_scale, k_scale)):
+        if dst.dtype == torch.float8_e4m3fn:
+            dst, src = dst.view(torch.uint8), src.view(torch.uint8)
+        dst.copy_(src[rank])
+    _prof.mark("qu_quant")
+    exchange.exchange(
+        {p: [q8[p], k8[p], v8[p], q_scale[p], k_scale[p]] for p in peers},
+        {p: slots(p) for p in peers},
+    )
+    _prof.mark("qu_xchg_in")
+
+    v_range = stats[:, 1, rank * local : (rank + 1) * local].amax(dim=0)
+    out = sage_attend(q_all, k_all, v_all, qs_all, ks_all, v_range, used, sm_scale)
+    _prof.mark("qu_attn")
+
+    out8, out_scale = row_quantize(out, total)
+    width = local * dim
+    staged = _fp8(world, rows, width, device=device)
+    scales = torch.empty(world, rows, dtype=torch.float32, device=device)
+    staged.view(torch.uint8)[rank] = out8.view(torch.uint8)[start : start + rows]
+    scales[rank] = out_scale[start : start + rows]
+    _prof.mark("qu_out_quant")
+
+    def shard(p):
+        return slice(p * rows, (p + 1) * rows)
+
+    exchange.exchange(
+        {p: [out8[shard(p)], out_scale[shard(p)]] for p in peers},
+        {p: [staged[p], scales[p]] for p in peers},
+    )
+    merged = row_merge(staged, scales)
+    _prof.mark("qu_xchg_out")
+    return merged
